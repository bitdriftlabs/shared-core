load("//tools/lint:linters.bzl", "rust_binary")
load("//tools/rust:feature_variants.bzl", "all_crate_deps_with_overrides")
load("//tools/rust:tests.bzl", "rust_library_with_test")

package(default_visibility = ["//visibility:public"])

WORKFLOW_BENCH_DEPS = all_crate_deps_with_overrides(
    dependency_overrides = {
        "//shared-core/bd-workflows": "//shared-core/bd-workflows:bd-workflows",
    },
    normal = True,
)

rust_library_with_test(
    name = "bd-workflow-bench",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
    ),
    crate_features = ["default"],
    crate_name = "bd_workflow_bench",
    crate_root = "src/lib.rs",
    edition = "2024",
    test_data = glob(["fixtures/**"]),
    deps = WORKFLOW_BENCH_DEPS,
)

rust_binary(
    name = "bd-workflow-bench-bin",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["default"],
    crate_name = "bd_workflow_bench",
    crate_root = "src/main.rs",
    edition = "2024",
    deps = WORKFLOW_BENCH_DEPS + [":bd-workflow-bench"],
)
