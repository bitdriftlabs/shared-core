fuzz_binary(
    name = "workflow_state",
    fuzz_runtime_data = FUZZ_RUNTIME_DATA,
    srcs = glob(["src/**/*.rs"]) + ["fuzz_targets/workflow_state.rs"],
    crate_features = ["default"],
