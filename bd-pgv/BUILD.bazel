load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("//tools/lint:linters.bzl", "rust_binary")
load("//tools/rust:tests.bzl", "rust_library_with_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "generate-protos",
    srcs = [
        "src/bin/generate_protos.rs",
        "src/proto_codegen.rs",
    ],
    crate_features = ["codegen"],
    crate_name = "generate_protos",
    crate_root = "src/bin/generate_protos.rs",
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "@crates//:protobuf-codegen",
    ],
)

rust_library_with_test(
    name = "bd-pgv",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
    ),
    crate_features = ["default"],
    crate_name = "bd_pgv",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = all_crate_deps(normal = True),
)
